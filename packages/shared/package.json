{
  "name": "@hive/shared",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./firestore": "./src/firestore.ts",
    "./agent-auth": "./src/agentAuth.ts",
    "./discovery": "./src/discovery.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --coverage",
    "test:rules": "vitest run -c vitest.rules.config.ts",
    "test:rules:core": "vitest run -c vitest.rules.config.ts --exclude rules/headroom-summary.test.ts",
    "test:rules:headroom": "vitest run -c vitest.rules.config.ts rules/headroom-summary.test.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "firebase": "^13.1.0"
  },
  "peerDependencies": {
    "firebase": "^13.1.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
