{
  "name": "@hive/agent",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --external:firebase --external:zod --external:@modelcontextprotocol/sdk && chmod +x dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@hive/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "vitest": "5.0.5"
  },
  "bin": {
    "hivenod": "./dist/cli.js"
  }
}
