      // BEGIN outcome registry (generated from packages/shared/src/outcomes.ts by
      // UPDATE_GO_CONTRACT=1 pnpm test:scripts; do not edit by hand)
      function outcomeTypes() { return ['reply', 'reply_book', 'book', 'no_reply', 'make_it_work', 'handover', 'snooze', 'nudge', 'ignore', 'shape', 'build', 'keepgreen', 'release', 'their_reply', 'approval']; }
      function outcomeSingle() { return ['reply', 'no_reply', 'handover', 'snooze', 'nudge', 'ignore']; }
      function outcomePlanTypes() { return ['reply', 'handover', 'snooze', 'nudge', 'shape', 'build', 'keepgreen', 'release', 'their_reply', 'approval']; }
      function outcomeHuman() { return ['approval']; }
      function outcomeImmediate() { return ['no_reply', 'snooze', 'ignore', 'approval']; }
      function outcomeLong() { return ['build', 'keepgreen', 'release']; }
      function outcomeAfter() { return {'reply': 'waiting', 'reply_book': 'waiting', 'book': 'waiting', 'no_reply': 'done', 'make_it_work': 'waiting', 'handover': 'waiting', 'snooze': 'waiting', 'nudge': 'waiting', 'ignore': 'ignored', 'shape': 'waiting', 'build': 'waiting', 'keepgreen': 'waiting', 'release': 'done', 'their_reply': 'waiting', 'approval': 'done'}; }
      function outcomeWaitingOn() { return {'reply': 'them', 'reply_book': 'them', 'book': 'them', 'no_reply': null, 'make_it_work': 'item', 'handover': 'thirdParty', 'snooze': 'date', 'nudge': 'them', 'ignore': null, 'shape': 'item', 'build': 'item', 'keepgreen': 'item', 'release': null, 'their_reply': 'them', 'approval': null}; }
      function outcomeFieldKeys() { return {'reply': ['text', 'holding'], 'no_reply': ['reason'], 'handover': ['to', 'note'], 'snooze': ['until', 'reason'], 'nudge': ['text'], 'ignore': ['reason'], 'shape': ['idea'], 'build': ['brief'], 'keepgreen': [], 'release': ['notes'], 'their_reply': ['who', 'org', 'channel', 'address', 'need', 'remindAfterDays'], 'approval': ['what', 'detail', 'link']}; }
      function outcomeRequired() { return {'reply': ['text'], 'no_reply': [], 'handover': ['to'], 'snooze': ['until'], 'nudge': ['text'], 'ignore': [], 'shape': [], 'build': [], 'keepgreen': [], 'release': [], 'their_reply': ['who', 'channel', 'address', 'need'], 'approval': ['what']}; }
      // END outcome registry

