          return signedIn() && !isDeleting()
          && exactKeys(d, ['actor', 'projectId', 'itemId', 'runId', 'type', 'data', 'at'])
          && exactKeys(d.actor, ['type', 'id', 'name'])
          && d.actor.id == me()
          && str(d.actor.name, 0, 200)
          && d.at == request.time
          && d.data is map
          && d.projectId == null && d.itemId == null && d.runId == null
