      function summaryAtt(a, t) { return a.matches(t + '_[A-Za-z0-9]{1,40}'); }
      function summaryVisualOk(v, t) {
        return v.kind in ['bar', 'line', 'stacked_bar', 'number', 'flow', 'before_after', 'timeline', 'image', 'image_pair']
          && summaryPlain(v.title, 80) && summaryPlain(v.caption, 200)
          && (v.kind in ['bar', 'line', 'stacked_bar'] ? v.x is list && v.x.size() >= 2 && v.x.size() <= 24
              && v.series is list && v.series.size() >= 1 && v.series.size() <= 4 && (v.kind != 'stacked_bar' || v.series.size() >= 2)
            : v.kind == 'number' ? v.value is number && (v.trend == null || v.trend.size() <= 24)
            : v.kind == 'flow' ? v.nodes is list && v.nodes.size() >= 2 && v.nodes.size() <= 8 && v.edges.size() <= 10
            : v.kind == 'before_after' ? v.before.lines.size() <= 6 && v.after.lines.size() <= 6
            : v.kind == 'image' ? summaryAtt(v.attachment, t)
            : v.kind == 'image_pair' ? summaryAtt(v.before, t) && summaryAtt(v.after, t)
            : v.events is list && v.events.size() >= 2 && v.events.size() <= 12);
      }
      function summaryVisualsOk(l, t) {
        return l.size() <= 4
          && (l.size() <= 0 || summaryVisualOk(l[0], t))
          && (l.size() <= 1 || summaryVisualOk(l[1], t))
          && (l.size() <= 2 || summaryVisualOk(l[2], t))
          && (l.size() <= 3 || summaryVisualOk(l[3], t));
      }
      // END summary checks
      function inboxSummaryDoc(tid) { return inboxDoc('inboxSummaries', tid); }
      function inboxSummaryVersionDoc(tid, v) { return inboxDoc('inboxSummaryVersions', tid + '_' + string(v)); }
      function inboxSummaryOk(tid, d, prev) {
        let t = get(inboxDoc('inboxThreads', tid)).data;
        return exactKeys(d, ['memberUid', 'threadId', 'version', 'by', 'at', 'headline', 'ask', 'answer',
               'recommendation', 'confidence', 'bullets', 'details', 'visuals', 'noVisualWhy', 'refs',
               'basis', 'lastEventId'])
          && t.fetchedBy == me() && d.memberUid == t.memberUid && d.threadId == tid
          && d.version == prev + 1 && d.by == me() && d.at == request.time
          && str(d.headline, 1, 120) && strOrNull(d.ask, 200) && strOrNull(d.answer, 160)
          && (d.recommendation == null
            || (d.recommendation is map && exactKeys(d.recommendation, ['action', 'why'])
              && str(d.recommendation.action, 1, 40) && str(d.recommendation.why, 1, 200)))
          && (d.confidence == null || d.confidence in ['high', 'medium', 'low'])
          && summaryBulletsOk(d.bullets)
          && strOrNull(d.details, 6000)
          && d.visuals is list && d.visuals.size() <= 4
          && strOrNull(d.noVisualWhy, 140)
          && (d.ask == null || d.visuals.size() > 0 || d.noVisualWhy != null)
          && d.refs is list && d.refs.size() <= 30
          && d.basis is map && exactKeys(d.basis, ['lastEventId', 'planCursor'])
          && strOrNull(d.basis.lastEventId, 128) && (d.basis.planCursor == null || d.basis.planCursor is int)
