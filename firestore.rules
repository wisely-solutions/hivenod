          return exactKeys(d, ['memberUid', 'threadId', 'kind', 'name', 'content', 'url', 'bytes', 'by', 'at', 'lastEventId'])
            && summaryAtt(aid, d.threadId) && t.fetchedBy == me() && d.memberUid == t.memberUid
            && d.by == me() && d.at == request.time && str(d.name, 1, 200) && d.bytes is int
            && (d.kind == 'link' ? d.content == null && str(d.url, 9, 2048) && d.url.matches('https://[^ ]+')
              : d.kind in ['html', 'markdown', 'text', 'pdf', 'image'] && d.url == null && str(d.content, 0, 921600)
