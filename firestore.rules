                && d.type in [
                  'agent.created', 'agent.revoked', 'agent.removed', 'agent.renamed', 'agent.rotated', 'agent.updated',
                  'workspace.created', 'workspace.updated', 'workspace.deleting', 'member.invited',
                  'member.joined', 'member.roleChanged', 'member.removed', 'member.inviteRevoked',
                  'group.created', 'group.updated', 'group.deleted'])
