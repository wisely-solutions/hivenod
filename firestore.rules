      }

      function inboxSummaryVersionOk(vid, d) {
        let s = getAfter(inboxSummaryDoc(d.threadId)).data;
        return vid == d.threadId + '_' + string(d.version)
          && d.keys().hasOnly(['memberUid', 'threadId', 'version', 'by', 'at', 'headline', 'ask', 'answer',
               'recommendation', 'confidence', 'bullets', 'details', 'visuals', 'noVisualWhy', 'refs',
               'basis', 'lastEventId'])
          && d.by == me() && d.at == request.time && s.at == request.time
          && d.version == s.version && d.memberUid == s.memberUid && d.lastEventId == s.lastEventId
          && d.headline == s.headline && d.ask == s.ask && d.answer == s.answer
          && d.recommendation == s.recommendation && d.confidence == s.confidence
          && d.details == s.details && d.noVisualWhy == s.noVisualWhy && d.basis == s.basis
          && d.bullets is list && d.bullets.size() >= 1 && d.bullets.size() <= 5
