          && (!('confidence' in d) || d.confidence in ['high', 'medium', 'low'])
          && d.get('sendBackTo', {}) is map && strOrNull(d.get('templateId', null), 40)
          && d.proposedBy == me()
          && d.state == (a ? 'proposed' : 'active') && d.cursor == 0
          && d.steps is list && d.steps.size() >= 1
          && d.steps.size() <= 8
          && d.steps.toSet().size() == d.steps.size()
          && str(d.note, 0, 2000)
          && d.createdAt == request.time
          && d.updatedAt == request.time
