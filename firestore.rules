      // UPDATE_GO_CONTRACT=1 pnpm test:scripts; do not edit by hand)
      function summaryPlain(v, max) { return str(v, 1, max) && !v.matches('(?s).*<[a-zA-Z/!].*'); }
      function summaryBulletOk(b) {
        return b.keys().hasOnly(['text', 'refs']) && str(b.text, 1, 160) && b.refs.size() <= 3;
      }
      function summaryBulletsOk(l) {
        return l is list && l.size() >= 1 && l.size() <= 5
          && (l.size() <= 0 || summaryBulletOk(l[0]))
          && (l.size() <= 1 || summaryBulletOk(l[1]))
          && (l.size() <= 2 || summaryBulletOk(l[2]))
          && (l.size() <= 3 || summaryBulletOk(l[3]))
          && (l.size() <= 4 || summaryBulletOk(l[4]));
